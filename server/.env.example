# ────────────────────────────────────────────────────────────────
#  VibeForge server configuration (v2 — SaaS mode)
#  Copy this file to ".env" and fill what you need.
# ────────────────────────────────────────────────────────────────
#
#  MINIMUM to go live:
#    1) one AI key below (Anthropic recommended)
#    2) MODEL_FREE / MODEL_STARTER / MODEL_PRO (which brain each plan uses)
#    3) ADMIN_TOKEN (so only you can open /admin)
#    4) SERVER_URL (your public https address once deployed)
# ────────────────────────────────────────────────────────────────

# ── the public address of this server (used for payment callbacks) ──
SERVER_URL=https://your-app.onrender.com

# ── admin dashboard: open at  /admin?token=YOUR_TOKEN ──
ADMIN_TOKEN=change-me-to-something-long-and-random

# ── extra protection for user passwords + stored keys (optional) ──
# if not set, a random key is generated in data/secret.key and reused
APP_SECRET=

# ════════════════════════════════════════════════════════════════
#  AI BRAINS — which model each plan gets    (format: provider:model)
# ════════════════════════════════════════════════════════════════
#  providers: anthropic | openai | openrouter | gemini | mock
MODEL_FREE=anthropic:claude-haiku-4-5
MODEL_STARTER=anthropic:claude-haiku-4-5
MODEL_PRO=anthropic:claude-sonnet-5

# ── Anthropic (recommended — strongest at code) ──
# console.anthropic.com → Billing (add ~$5) → API Keys
ANTHROPIC_API_KEY=

# ── OpenAI (or any OpenAI-compatible API via OPENAI_BASE_URL) ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── OpenRouter (cheapest models — great for the Free tier) ──
# openrouter.ai/keys — one key, hundreds of models, pay per use
# example cheap model: meta-llama/llama-3.3-70b-instruct  or  deepseek/deepseek-chat
OPENROUTER_API_KEY=

# ── Google Gemini ──
GEMINI_API_KEY=

# ════════════════════════════════════════════════════════════════
#  PAYMENTS — Razorpay (razorpay.com → Account & Settings → API Keys)
#  Start in TEST MODE. Switch to live keys when ready.
#  Webhook: Razorpay Dashboard → Webhooks → add
#           URL:    https://your-server/api/billing/webhook
#           Events: payment_link.paid, payment.captured
#           Secret: paste the same value into RAZORPAY_WEBHOOK_SECRET
# ════════════════════════════════════════════════════════════════
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── server ──
PORT=8787
HOST=0.0.0.0
